# ---------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
tmp/
temp/

# ---------------------------
# Environment / secrets
# ---------------------------
.env
.env.*
!.env.example
*.local
appsettings.Local.json
secrets.json

